# -----------------------------------------------------------------------
# keber/qa-framework — Environment Variables Reference
# -----------------------------------------------------------------------
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# -----------------------------------------------------------------------

# -----------------------------------------------------------------------
# Application Under Test
# -----------------------------------------------------------------------
QA_BASE_URL=https://your-app.qa.example.com

# -----------------------------------------------------------------------
# Session and login resilience
# -----------------------------------------------------------------------
QA_SESSION_TTL_MS=7200000
# Optional path to a server-side logout endpoint if the app exposes one.
# QA_LOGOUT_PATH=/logout

# -----------------------------------------------------------------------
# Parallel QA lanes
# -----------------------------------------------------------------------
# A lane is a distinct QA account. Lanes exist because the app under test
# invalidates a session when the same account logs in again, so two workers
# sharing one account silently destroy each other's session.
#
# The lane table itself lives in qa-framework.config.json (parallelLanes.lanes).
# Each lane needs its own credentials here, named after that lane's "account"
# prefix. With no parallelLanes config, only the QA_USER pair below is used.

# Pin a run to a single lane. Required by global-setup unless QA_COLD_SETUP=1.
# QA_LANE_ONLY=1

# Escape hatch for an intentional relogin of EVERY lane. A cold setup can
# invalidate another agent's or CI job's running session, so it is never implicit.
# QA_COLD_SETUP=1

# Log in a specific set of lanes (comma-separated lane ids).
# QA_AUTH_USER=1

# Shared lane-lock state directory. Set this to an absolute shared path when
# running from multiple git worktrees or checkouts: with the per-checkout default
# each one gets its OWN lock state, so they never contend, every command reports
# success, and two sessions can land on the same account. The failure is silent.
# QA_LANE_LOCKS_DIR=/absolute/path/to/shared/.locks

# Minutes before a held lane is swept as stale. A lane with a recent heartbeat is
# never swept regardless of age.
# QA_LANE_STALE_MINUTES=20

# Credentials for additional lanes, one pair per lane account prefix.
# QA_USER2_EMAIL=qa-user2@example.com
# QA_USER2_PASSWORD=CHANGE_ME
# QA_USER3_EMAIL=qa-user3@example.com
# QA_USER3_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------
# Login Configuration
# These selectors allow the framework to work with any login form.
# -----------------------------------------------------------------------
QA_LOGIN_PATH=/login
QA_LOGIN_EMAIL_SELECTOR=input[type="email"]
QA_LOGIN_PASSWORD_SELECTOR=input[type="password"]
QA_LOGIN_SUBMIT_SELECTOR=button[type="submit"]
# Selector that appears AFTER successful login (used by global-setup to confirm):
QA_LOGIN_SUCCESS_SELECTOR=.dashboard

# -----------------------------------------------------------------------
# Test Users
# Add one block per role your project uses.
# -----------------------------------------------------------------------

# Default / Standard user
QA_USER_EMAIL=qa-user@example.com
QA_USER_PASSWORD=CHANGE_ME

# Admin user (uncomment if multi-role setup is needed)
# QA_ADMIN_EMAIL=qa-admin@example.com
# QA_ADMIN_PASSWORD=CHANGE_ME

# Read-only / viewer user
# QA_READONLY_EMAIL=qa-readonly@example.com
# QA_READONLY_PASSWORD=CHANGE_ME

# If your app uses RUT-based login instead of email:
# QA_USER_RUT=12345678-9

# -----------------------------------------------------------------------
# Azure DevOps Integration  (optional — leave blank to disable)
# -----------------------------------------------------------------------
# ADO_ORG_URL=https://dev.azure.com/your-org
# ADO_PROJECT_NAME=YourProject
# ADO_PLAN_ID=00000
# AZURE_TOKEN=your-pat-token-here   # Personal Access Token — NEVER commit

# -----------------------------------------------------------------------
# CI / Pipeline overrides
# -----------------------------------------------------------------------
# CI=true           # Set automatically by most CI systems
# ADO_SYNC_DISABLED=false   # Set to true to skip ADO reporter in local runs

# -----------------------------------------------------------------------
# Playwright Service  (optional - only needed for cloud or self-hosted grid)
# -----------------------------------------------------------------------
# PLAYWRIGHT_SERVICE_URL=wss://eastus.api.playwright.microsoft.com/accounts/<your-id>/browsers
